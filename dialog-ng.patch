+// a section title: a small pill, as in Dolphin NG
+class NgPill : public QWidget
+{
+public:
+    NgPill(const QString &text, QWidget *parent)
+        : QWidget(parent)
+        , m_text(text)
+    {
+        QFont f = font();
+        f.setPointSizeF(f.pointSizeF() * 0.84);
+        f.setWeight(QFont::DemiBold);
+        setFont(f);
+        setSizePolicy(QSizePolicy::Preferred, QSizePolicy::Fixed);
+    }
+    QSize sizeHint() const override
+    {
+        const QFontMetrics fm(font());
+        return QSize(fm.horizontalAdvance(m_text) + 22, fm.height() + 12);
+    }
+
+protected:
+    void paintEvent(QPaintEvent *) override
+    {
+        QPainter painter(this);
+        painter.setRenderHint(QPainter::Antialiasing);
+        const QFontMetrics fm(font());
+        const QRectF pill(2, 6, fm.horizontalAdvance(m_text) + 18, fm.height() + 4);
+        QColor ink = palette().color(QPalette::WindowText);
+        ink.setAlphaF(0.12);
+        painter.setPen(Qt::NoPen);
+        painter.setBrush(ink);
+        painter.drawRoundedRect(pill, pill.height() / 2, pill.height() / 2);
+        ink.setAlphaF(0.85);
+        painter.setPen(ink);
+        painter.drawText(pill, Qt::AlignCenter, m_text);
+    }
+
+private:
+    QString m_text;
+};
