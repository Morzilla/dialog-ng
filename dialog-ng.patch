+// ---------------------------------------------------------------------------------------------------------------
+// kio-ng: the rows of Dialog NG
+namespace
+{
+bool ngItalian()
+{
+    return KLocalizedString::languages().value(0).startsWith(QLatin1String("it"));
+}
+QString ngTr(const char *english, const char *italian)
+{
+    return QString::fromUtf8(ngItalian() ? italian : english);
+}
+QString ngPlural(int n, const char *oneEn, const char *manyEn, const char *oneIt, const char *manyIt)
+{
+    const bool it = ngItalian();
+    return QString::fromUtf8(n == 1 ? (it ? oneIt : oneEn) : (it ? manyIt : manyEn)).arg(n);
+}
+
+// how long ago, the way Dolphin NG says it
+QString ngAgo(const QDateTime &when, bool withTime)
+{
+    if (!when.isValid()) {
+        return QString();
+    }
+    const qint64 days = when.date().daysTo(QDate::currentDate());
+    const QString time = QLocale().toString(when.time(), QLocale::ShortFormat);
+    if (days <= 0) {
+        return withTime ? ngTr("today", "oggi") + QLatin1Char(' ') + time : ngTr("today", "oggi");
+    }
+    if (days == 1) {
+        return withTime ? ngTr("yesterday", "ieri") + QLatin1Char(' ') + time : ngTr("yesterday", "ieri");
+    }
+    if (days < 60) {
+        return ngPlural(int(days), "%1 day ago", "%1 days ago", "%1 giorno fa", "%1 giorni fa");
+    }
+    if (days < 365) {
+        return ngPlural(int(days / 30), "%1 month ago", "%1 months ago", "%1 mese fa", "%1 mesi fa");
+    }
+    return ngPlural(int(days / 365), "%1 year ago", "%1 years ago", "%1 anno fa", "%1 anni fa");
+}
+
+// pinned in Dolphin NG: the mark is kept with the file (extended attribute), read again after a few seconds
+bool ngPinned(const KFileItem &item)
+{
+    static QHash<QString, std::pair<bool, qint64>> cache;
+    static QElapsedTimer clock;
+    if (!clock.isValid()) {
+        clock.start();
+    }
+    const QString path = item.localPath();
+    if (path.isEmpty()) {
+        return false;
+    }
+    auto it = cache.find(path);
+    if (it != cache.end() && clock.elapsed() - it->second < 5000) {
+        return it->first;
+    }
+    const bool pinned = ::getxattr(QFile::encodeName(path).constData(), "user.ng.pinned", nullptr, 0) >= 0;
+    if (cache.size() > 5000) {
+        cache.clear();
+    }
+    cache.insert(path, {pinned, clock.elapsed()});
+    return pinned;
+}
+
+// the group a row belongs to: it follows the sort order (pinned items and, when they come first, folders apart)
+QString ngGroupOf(const KFileItem &item, QDir::SortFlags sorting, bool created)
+{
+    if (ngPinned(item)) {
+        return ngTr("Pinned", "Fissati");
+    }
+    if ((sorting & QDir::DirsFirst) && item.isDir()) {
+        return ngTr("Folders", "Cartelle");
+    }
+    switch (sorting & QDir::SortByMask) {
+    case QDir::Time: {
+        const QDateTime when = item.time(created ? KFileItem::CreationTime : KFileItem::ModificationTime);
+        const qint64 days = when.isValid() ? when.date().daysTo(QDate::currentDate()) : 9999;
+        if (days <= 0) {
+            return ngTr("Today", "Oggi");
+        }
+        if (days == 1) {
+            return ngTr("Yesterday", "Ieri");
+        }
+        if (days < 7) {
+            return ngTr("This week", "Questa settimana");
+        }
+        if (days < 31) {
+            return ngTr("This month", "Questo mese");
+        }
+        if (when.date().year() == QDate::currentDate().year()) {
+            return ngTr("This year", "Quest'anno");
+        }
+        return ngTr("Earlier", "Prima");
+    }
+    case QDir::Type:
+        return item.isDir() ? ngTr("Folders", "Cartelle") : item.mimeComment();
+    case QDir::Size:
+        if (item.isDir()) {
+            return ngTr("Folders", "Cartelle");
+        }
+        if (item.size() < 1024 * 1024) {
+            return ngTr("Small (under 1 MiB)", "Piccoli (meno di 1 MiB)");
+        }
+        if (item.size() < 100 * 1024 * 1024) {
+            return ngTr("Medium (1 to 100 MiB)", "Medi (da 1 a 100 MiB)");
+        }
+        return ngTr("Large (over 100 MiB)", "Grandi (oltre 100 MiB)");
+    default: {
+        const QChar first = item.text().isEmpty() ? QChar() : item.text().at(0).toUpper();
+        return first.isLetter() ? QString(first) : QStringLiteral("#");
+    }
+    }
+}
