+// a row of the sidebar's own sections (pinned items, filters): icon, label, a number on the right
+class NgSideRow : public QAbstractButton
+{
+public:
+    NgSideRow(const QIcon &icon, const QString &text, const QString &count, QWidget *parent)
+        : QAbstractButton(parent)
+        , m_count(count)
+    {
+        setIcon(icon);
+        setText(text);
+        setToolTip(text);
+        setCursor(Qt::PointingHandCursor);
+        setAttribute(Qt::WA_Hover);
+        setSizePolicy(QSizePolicy::Expanding, QSizePolicy::Fixed);
+    }
+    QSize sizeHint() const override
+    {
+        return QSize(120, qMax(30, fontMetrics().height() + 12));
+    }
+
+protected:
+    void paintEvent(QPaintEvent *) override
+    {
+        QPainter painter(this);
+        painter.setRenderHint(QPainter::Antialiasing);
+        QColor ink = palette().color(QPalette::WindowText);
+        const QRectF row = QRectF(rect()).adjusted(2, 1, -2, -1);
+        if (isChecked() || underMouse()) {
+            QColor ground = ink;
+            ground.setAlphaF(isChecked() ? 0.14 : 0.07);
+            painter.setPen(Qt::NoPen);
+            painter.setBrush(ground);
+            painter.drawRoundedRect(row, row.height() / 2, row.height() / 2);
+        }
+        const int iconSize = 18;
+        icon().paint(&painter, QRect(int(row.left()) + 10, int(row.center().y()) - iconSize / 2, iconSize, iconSize));
+        QColor dim = ink;
+        dim.setAlphaF(0.6);
+        const QFontMetrics fm(font());
+        const int countWidth = m_count.isEmpty() ? 0 : fm.horizontalAdvance(m_count) + 10;
+        // KDE's accelerator manager adds "&" marks to the buttons of a dialog: drawn by hand, they would show
+        const QString label = KLocalizedString::removeAcceleratorMarker(text());
+        painter.setPen(ink);
+        painter.drawText(QRectF(row.left() + 38, row.top(), row.width() - 48 - countWidth, row.height()), Qt::AlignLeft | Qt::AlignVCenter,
+                         fm.elidedText(label, Qt::ElideMiddle, int(row.width() - 48 - countWidth)));
+        if (!m_count.isEmpty()) {
+            painter.setPen(dim);
+            painter.drawText(QRectF(row.right() - countWidth - 4, row.top(), countWidth, row.height()), Qt::AlignRight | Qt::AlignVCenter, m_count);
+        }
+    }
+
+private:
+    QString m_count;
+};
