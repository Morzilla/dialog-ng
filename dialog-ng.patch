+// kio-ng: the bar of Dialog NG -------------------------------------------------------------------------------------
+QWidget *KFileWidgetPrivate::ngBar(QWidget *parent)
+{
+    auto *bar = new QWidget(parent);
+    auto *rows = new QVBoxLayout(bar);
+    rows->setContentsMargins(8, 2, 8, 6);
+    rows->setSpacing(2);
+    auto *layout = new QHBoxLayout();
+    layout->setContentsMargins(0, 0, 0, 0);
+    layout->setSpacing(4);
+    rows->addLayout(layout);
+    m_ngChipsRow = new QHBoxLayout();
+    m_ngChipsRow->setContentsMargins(0, 0, 0, 0);
+    rows->addLayout(m_ngChipsRow);
+    m_ngBarRow = layout;
+    auto button = [&](const char *icon) {
+        auto *b = new QToolButton(bar);
+        b->setAutoRaise(true);
+        b->setToolButtonStyle(Qt::ToolButtonTextBesideIcon);
+        b->setIcon(QIcon::fromTheme(QString::fromLatin1(icon)));
+        b->setPopupMode(QToolButton::InstantPopup);
+        b->setMenu(new QMenu(b));
+        layout->addWidget(b);
+        return b;
+    };
+    m_ngSortButton = button("view-sort");
+    m_ngViewButton = button("view-list-details");
+    m_ngFiltersButton = button("view-filter");
+    m_ngGroupsButton = button("view-group");
+    // the filters: the kinds present as chips when there is room, otherwise the button with its menu
+    layout->removeWidget(m_ngFiltersButton);
+    layout->addWidget(m_ngFiltersButton);
+    m_ngChips = new QWidget(bar);
+    auto *chipLayout = new QHBoxLayout(m_ngChips);
+    chipLayout->setContentsMargins(10, 0, 0, 0);
+    chipLayout->setSpacing(2);
+    layout->addWidget(m_ngChips);
+    layout->addStretch(1);
+    m_ngChipsRow->addStretch(1);
+    {
+        const QColor ink = bar->palette().color(QPalette::WindowText);
+        m_ngChips->setStyleSheet(QStringLiteral("QToolButton { border: none; border-radius: 12px; padding: 3px 10px; }"
+                                                "QToolButton:hover { background: rgba(%1, %2, %3, 0.08); }"
+                                                "QToolButton:checked { background: rgba(%1, %2, %3, 0.16); }")
+                                     .arg(ink.red())
+                                     .arg(ink.green())
+                                     .arg(ink.blue()));
+    }
+    struct Watcher : QObject {
+        std::function<void()> resized;
+        bool eventFilter(QObject *, QEvent *event) override
+        {
+            if (event->type() == QEvent::Resize) {
+                resized();
+            }
+            return false;
+        }
+    };
+    auto *watcher = new Watcher;
+    watcher->setParent(bar);
+    watcher->resized = [this] {
+        ngFitBar();
+    };
+    bar->installEventFilter(watcher);
+
+    // sort: KDirOperator's own actions
+    QObject::connect(m_ngSortButton->menu(), &QMenu::aboutToShow, q, [this] {
+        QMenu *menu = m_ngSortButton->menu();
+        menu->clear();
+        menu->addAction(m_ops->action(KDirOperator::SortByName));
+        menu->addAction(m_ops->action(KDirOperator::SortBySize));
+        // the date of change or of creation, instead of KDE's one "by date"
+        const bool byDate = (m_ops->sorting() & QDir::SortByMask) == QDir::Time;
+        const bool created = m_ops->property("_ng_created").toBool();
+        for (const bool which : {false, true}) {
+            QAction *action = menu->addAction(which ? ngLabel(nullptr, nullptr, "Sort by Date Created", "Ordina per data di creazione")
+                                                    : ngLabel(nullptr, nullptr, "Sort by Date Modified", "Ordina per data di modifica"));
+            action->setCheckable(true);
+            action->setChecked(byDate && created == which);
+            QObject::connect(action, &QAction::triggered, q, [this, which] {
+                ngSetSortCreated(which);
+            });
+        }
+        menu->addAction(m_ops->action(KDirOperator::SortByType));
+        menu->addSeparator();
+        menu->addAction(m_ops->action(KDirOperator::SortAscending));
+        menu->addAction(m_ops->action(KDirOperator::SortDescending));
+        menu->addSeparator();
+        menu->addAction(m_ops->action(KDirOperator::SortFoldersFirst));
+        menu->addAction(m_ops->action(KDirOperator::SortHiddenFilesLast));
+    });
+    for (auto a : {KDirOperator::SortByName, KDirOperator::SortBySize, KDirOperator::SortByDate, KDirOperator::SortByType, KDirOperator::SortAscending,
+                   KDirOperator::SortDescending, KDirOperator::SortFoldersFirst}) {
+        QObject::connect(m_ops->action(a), &QAction::triggered, q, [this] {
+            QTimer::singleShot(0, q, [this] {
+                ngUpdateBar();
+            });
+        });
+    }
+
+    // view: the NG rows (two lines or compact), KDE's columns, icons; the zoom and the previews
+    QObject::connect(m_ngViewButton->menu(), &QMenu::aboutToShow, q, [this] {
+        QMenu *menu = m_ngViewButton->menu();
+        menu->clear();
+        auto *group = new QActionGroup(menu);
+        const std::pair<QString, QString> modes[] = {{QStringLiteral("rows"), ngLabel(nullptr, nullptr, "Rows", "Righe")},
+                                                     {QStringLiteral("compact"), ngLabel(nullptr, nullptr, "Compact rows", "Righe compatte")},
+                                                     {QStringLiteral("details"), ngLabel(nullptr, nullptr, "Details (columns)", "Dettagli (colonne)")},
+                                                     {QStringLiteral("icons"), ngLabel(nullptr, nullptr, "Icons", "Icone")}};
+        for (const auto &[mode, label] : modes) {
+            QAction *action = menu->addAction(label);
+            action->setCheckable(true);
+            action->setChecked(m_ngView == mode);
+            group->addAction(action);
+            QObject::connect(action, &QAction::triggered, q, [this, mode] {
+                ngSetView(mode);
+            });
+        }
+        menu->addSeparator();
+        menu->addAction(m_ops->action(KDirOperator::ShowPreview));
+        // the large picture when the pointer rests on a file: a setting of the dialog's own (Dolphin NG has its own)
+        QAction *quick = menu->addAction(ngLabel(nullptr, nullptr, "Quick Preview on Hover", "Anteprima al passaggio del mouse"));
+        quick->setCheckable(true);
+        quick->setChecked(m_ops->property("_ng_quick").toBool());
+        QObject::connect(quick, &QAction::toggled, q, [this](bool on) {
+            m_ops->setProperty("_ng_quick", on);
+            KConfigGroup ng(KSharedConfig::openConfig(QStringLiteral("dialog-ngrc")), QStringLiteral("View"));
+            ng.writeEntry("QuickPreview", on);
+            ng.sync();
+        });
+        menu->addSeparator();
+        menu->addAction(m_zoomInAction);
+        menu->addAction(m_zoomOutAction);
+    });
+
+    // filters: the kinds present in the folder, with how many there are
+    QObject::connect(m_ngFiltersButton->menu(), &QMenu::aboutToShow, q, [this] {
+        QMenu *menu = m_ngFiltersButton->menu();
+        menu->clear();
+        ngCountKinds();
+        auto *group = new QActionGroup(menu);
+        for (int kind = 0; kind < ngFilterCount; ++kind) {
+            const int count = m_ngKindCounts.value(kind);
+            if (kind != 0 && count == 0 && kind != m_ngFilter) {
+                continue;
+            }
+            QAction *action = menu->addAction(QIcon::fromTheme(QString::fromLatin1(ngFilterKinds[kind].icon)),
+                                              ngLabel(ngFilterKinds[kind].domain, ngFilterKinds[kind].context, ngFilterKinds[kind].label, ngFilterKinds[kind].labelIt)
+                                                  + QLatin1Char('\t') + QString::number(count));
+            action->setCheckable(true);
+            action->setChecked(kind == m_ngFilter);
+            group->addAction(action);
+            QObject::connect(action, &QAction::triggered, q, [this, kind] {
+                ngSetFilter(kind);
+            });
+        }
+    });
+
+    // groups: titles between the rows, by the sort key chosen here
+    QObject::connect(m_ngGroupsButton->menu(), &QMenu::aboutToShow, q, [this] {
+        QMenu *menu = m_ngGroupsButton->menu();
+        menu->clear();
+        auto *group = new QActionGroup(menu);
+        const bool on = m_ops->property("_ng_groups").toBool();
+        const QDir::SortFlags by = m_ops->sorting() & QDir::SortByMask;
+        const struct {
+            int id;
+            const char *en;
+            const char *it;
+            bool checked;
+        } entries[] = {{0, "None", "Nessuno", !on},
+                       {1, "By date", "Per data", on && by == QDir::Time},
+                       {2, "By type", "Per tipo", on && by == QDir::Type},
+                       {3, "By name", "Per nome", on && by == QDir::Name},
+                       {4, "By size", "Per dimensione", on && by == QDir::Size}};
+        for (const auto &entry : entries) {
+            QAction *action = menu->addAction(ngLabel(nullptr, nullptr, entry.en, entry.it));
+            action->setCheckable(true);
+            action->setChecked(entry.checked);
+            group->addAction(action);
+            const int id = entry.id;
+            QObject::connect(action, &QAction::triggered, q, [this, id] {
+                ngSetGroups(id);
+            });
+        }
+        if (m_ngView != QLatin1String("rows") && m_ngView != QLatin1String("compact")) {
+            menu->setEnabled(true);
+            menu->addSeparator();
+            menu->addAction(ngLabel(nullptr, nullptr, "(in the rows views)", "(nelle viste a righe)"))->setEnabled(false);
+        }
+    });
+
+    QObject::connect(m_ops->dirLister(), &KCoreDirLister::completed, q, [this] {
+        ngUpdateBar();
+        ngFillChips();
+    });
+    QObject::connect(m_ops->dirLister(), &KCoreDirLister::itemsDeleted, q, [this] {
+        ngFillChips();
+    });
+    ngUpdateBar();
+    return bar;
+}
+
+void KFileWidgetPrivate::ngUpdateBar()
+{
+    if (!m_ngSortButton) {
+        return;
+    }
+    const QDir::SortFlags sorting = m_ops->sorting();
+    QString by;
+    switch (sorting & QDir::SortByMask) {
+    case QDir::Time:
+        by = m_ops->property("_ng_created").toBool() ? ngLabel(nullptr, nullptr, "Created", "Creazione") : ngLabel(nullptr, nullptr, "Modified", "Modifica");
+        break;
+    case QDir::Size:
+        by = ngLabel(nullptr, nullptr, "Size", "Dimensione");
+        break;
+    case QDir::Type:
+        by = ngLabel(nullptr, nullptr, "Type", "Tipo");
+        break;
+    default:
+        by = ngLabel(nullptr, nullptr, "Name", "Nome");
+    }
+    m_ngSortButton->setText(ngLabel(nullptr, nullptr, "Sort: %1", "Ordina: %1").arg(by));
+    m_ngSortButton->setIcon(QIcon::fromTheme((sorting & QDir::Reversed) ? QStringLiteral("view-sort-descending") : QStringLiteral("view-sort-ascending")));
+
+    const QString view = m_ngView == QLatin1String("compact") ? ngLabel(nullptr, nullptr, "Compact rows", "Righe compatte")
+        : m_ngView == QLatin1String("details")                ? ngLabel(nullptr, nullptr, "Details", "Dettagli")
+        : m_ngView == QLatin1String("icons")                  ? ngLabel(nullptr, nullptr, "Icons", "Icone")
+                                                              : ngLabel(nullptr, nullptr, "Rows", "Righe");
+    m_ngViewButton->setText(view);
+    m_ngViewButton->setIcon(QIcon::fromTheme(m_ngView == QLatin1String("icons") ? QStringLiteral("view-list-icons") : QStringLiteral("view-list-details")));
+
+    const auto &kind = ngFilterKinds[qBound(0, m_ngFilter, ngFilterCount - 1)];
+    m_ngFiltersButton->setText(ngLabel(nullptr, nullptr, "Filters: %1", "Filtri: %1").arg(ngLabel(kind.domain, kind.context, kind.label, kind.labelIt)));
+
+    const bool rows = m_ngView == QLatin1String("rows") || m_ngView == QLatin1String("compact");
+    m_ngGroupsButton->setText(ngLabel(nullptr, nullptr, "Groups: %1", "Gruppi: %1")
+                                  .arg(m_ops->property("_ng_groups").toBool() && rows ? by : ngLabel(nullptr, nullptr, "none", "nessuno")));
+}
+
+void KFileWidgetPrivate::ngFillChips()
+{
+    if (!m_ngChips) {
+        return;
+    }
+    ngCountKinds();
+    QLayout *layout = m_ngChips->layout();
+    while (QLayoutItem *item = layout->takeAt(0)) {
+        delete item->widget();
+        delete item;
+    }
+    for (int kind = 0; kind < ngFilterCount; ++kind) {
+        const int count = m_ngKindCounts.value(kind);
+        if (kind != 0 && count == 0 && kind != m_ngFilter) {
+            continue;
+        }
+        auto *chip = new QToolButton(m_ngChips);
+        chip->setAutoRaise(true);
+        chip->setCheckable(true);
+        chip->setChecked(kind == m_ngFilter);
+        chip->setToolButtonStyle(Qt::ToolButtonTextOnly);
+        const QString label = kind == 0 ? ngLabel(nullptr, nullptr, "All", "Tutti")
+                                        : ngLabel(ngFilterKinds[kind].domain, ngFilterKinds[kind].context, ngFilterKinds[kind].label, ngFilterKinds[kind].labelIt);
+        chip->setText(QStringLiteral("%1  %2").arg(label).arg(count));
+        QObject::connect(chip, &QToolButton::clicked, q, [this, kind] {
+            ngSetFilter(kind);
+        });
+        layout->addWidget(chip);
+    }
+    ngFitBar();
+    ngFillSide();
+}
+
+void KFileWidgetPrivate::ngFitBar()
+{
+    // the chips need the room they ask for, beside the other buttons; when it is not there, the menu button stands
+    // for them
+    if (!m_ngChips || !m_ngFiltersButton) {
+        return;
+    }
+    QWidget *bar = m_ngChips->parentWidget();
+    const int width = bar->width() - 16;
+    const int fixed = m_ngSortButton->sizeHint().width() + m_ngViewButton->sizeHint().width() + m_ngGroupsButton->sizeHint().width() + 24;
+    const int chips = m_ngChips->sizeHint().width();
+    // beside the buttons; else on a row of their own; else the button and its menu
+    const bool inline_ = fixed + chips <= width;
+    const bool ownRow = !inline_ && chips <= width;
+    if (inline_ && m_ngBarRow->indexOf(m_ngChips) < 0) {
+        m_ngChipsRow->removeWidget(m_ngChips);
+        m_ngBarRow->insertWidget(m_ngBarRow->count() - 1, m_ngChips);
+    } else if (ownRow && m_ngChipsRow->indexOf(m_ngChips) < 0) {
+        m_ngBarRow->removeWidget(m_ngChips);
+        m_ngChipsRow->insertWidget(0, m_ngChips);
+    }
+    m_ngChips->layout()->setContentsMargins(inline_ ? 10 : 0, 0, 0, 0);
+    m_ngChips->setVisible(inline_ || ownRow);
+    m_ngFiltersButton->setVisible(!inline_ && !ownRow);
+}
+
+void KFileWidgetPrivate::ngSetSortCreated(bool created)
+{
+    KConfigGroup ng(KSharedConfig::openConfig(QStringLiteral("dialog-ngrc")), QStringLiteral("View"));
+    ng.writeEntry("SortCreated", created);
+    ng.sync();
+    m_ops->setProperty("_ng_created", created);
+    if (auto *proxy = m_ops->findChild<KDirSortFilterProxyModel *>()) {
+        proxy->setProperty("_ng_created", created);
+    }
+    m_ops->action(KDirOperator::SortByDate)->trigger(); // newest first, as one usually wants by date
+    m_ops->action(KDirOperator::SortDescending)->trigger();
+    if (auto *proxy = m_ops->findChild<KDirSortFilterProxyModel *>()) {
+        proxy->invalidate();
+    }
+    if (QAbstractItemView *view = m_ops->view()) {
+        view->doItemsLayout();
+        view->viewport()->update();
+    }
+    ngUpdateBar();
+}
+
+void KFileWidgetPrivate::ngSetView(const QString &mode)
+{
+    m_ngView = mode;
+    KConfigGroup ng(KSharedConfig::openConfig(QStringLiteral("dialog-ngrc")), QStringLiteral("View"));
+    ng.writeEntry("Mode", mode);
+    ng.sync();
+    m_ops->setProperty("_ng_rows", mode == QLatin1String("rows") ? 1 : mode == QLatin1String("compact") ? 2 : 0);
+    if (mode == QLatin1String("icons")) {
+        m_ops->action(KDirOperator::ViewIconsView)->trigger();
+    } else {
+        m_ops->setViewMode(KFile::Detail);
+    }
+    ngUpdateBar();
+}
+
+void KFileWidgetPrivate::ngSetGroups(int by)
+{
+    // a group follows the sort key: choosing one sorts by it (dates and sizes from the largest/newest)
+    KConfigGroup ng(KSharedConfig::openConfig(QStringLiteral("dialog-ngrc")), QStringLiteral("View"));
+    ng.writeEntry("Groups", by != 0);
+    ng.sync();
+    m_ops->setProperty("_ng_groups", by != 0);
+    const KDirOperator::Action sortBy[] = {KDirOperator::SortByName, KDirOperator::SortByDate, KDirOperator::SortByType, KDirOperator::SortByName, KDirOperator::SortBySize};
+    if (by != 0) {
+        m_ops->action(sortBy[by])->trigger();
+        m_ops->action(by == 1 || by == 4 ? KDirOperator::SortDescending : KDirOperator::SortAscending)->trigger();
+    }
+    if (QAbstractItemView *view = m_ops->view()) {
+        view->doItemsLayout(); // the titles change the height of the rows
+        view->viewport()->update();
+    }
+    ngUpdateBar();
+}
+
+void KFileWidgetPrivate::ngCountKinds()
+{
+    // what the folder holds, all of it (not what the current filter shows)
+    static QList<QSet<QString>> suffixes;
+    if (suffixes.isEmpty()) {
+        for (int kind = 0; kind < ngFilterCount; ++kind) {
+            QSet<QString> set;
+            for (const QString &pattern : QString::fromLatin1(ngFilterKinds[kind].patterns).split(QLatin1Char(' '), Qt::SkipEmptyParts)) {
+                set.insert(pattern.mid(2));
+            }
+            suffixes.append(set);
+        }
+    }
+    m_ngKindCounts = QList<int>(ngFilterCount, 0);
+    const KFileItemList items = m_ops->dirLister()->items(KCoreDirLister::AllItems);
+    for (const KFileItem &item : items) {
+        if (!m_ops->dirLister()->showHiddenFiles() && item.isHidden()) {
+            continue;
+        }
+        ++m_ngKindCounts[0];
+        if (item.isDir()) {
+            continue;
+        }
+        const QString suffix = QFileInfo(item.name()).suffix().toLower();
+        for (int kind = 1; kind < ngFilterCount; ++kind) {
+            if (suffixes.at(kind).contains(suffix)) {
+                ++m_ngKindCounts[kind];
+                break;
+            }
+        }
+    }
+}
+
+// kio-ng: the sidebar of Dialog NG ----------------------------------------------------------------------------------
+QWidget *KFileWidgetPrivate::ngSidebar(QWidget *parent)
+{
+    m_ngCard = new NgSideCard(parent);
+    m_ngCard->glass = m_ngGlassWindow != nullptr;
+    m_ngCard->geometryChanged = [this] {
+        ngUpdateBlur();
+    };
+    auto *layout = new QVBoxLayout(m_ngCard);
+    layout->setContentsMargins(14, 12, 12, 14);
+    layout->setSpacing(1);
+
+    // the places, on the card: no ground of their own, section titles as pills
+    m_placesView->setProperty("ngPills", true);
+    m_placesView->setFrameShape(QFrame::NoFrame);
+    m_placesView->setAutoFillBackground(false);
+    m_placesView->viewport()->setAutoFillBackground(false);
+    QPalette clear = m_placesView->palette();
+    clear.setColor(QPalette::Base, Qt::transparent);
+    m_placesView->setPalette(clear);
+    layout->addWidget(m_placesView, 1);
+
+    // pinned in Dolphin NG (dolphinrc): folders first, then files
+    {
+        const KConfigGroup dolphin(KSharedConfig::openConfig(QStringLiteral("dolphinrc")), QStringLiteral("DolphinNG"));
+        QStringList folders, files;
+        for (const QString &path : dolphin.readEntry("PinnedPaths", QStringList())) {
+            const QFileInfo info(path);
+            if (info.exists()) {
+                (info.isDir() ? folders : files).append(path);
+            }
+        }
+        if (!folders.isEmpty() || !files.isEmpty()) {
+            layout->addSpacing(4);
+            layout->addWidget(new NgPill(ngLabel(nullptr, nullptr, "Pinned", "Fissati"), m_ngCard));
+            QMimeDatabase db;
+            for (const QString &path : folders + files) {
+                const QFileInfo info(path);
+                const QIcon icon = info.isDir() ? QIcon::fromTheme(QStringLiteral("folder")) : QIcon::fromTheme(db.mimeTypeForFile(info).iconName());
+                auto *row = new NgSideRow(icon, info.fileName(), QString(), m_ngCard);
+                const bool folder = info.isDir();
+                QObject::connect(row, &QAbstractButton::clicked, q, [this, path, folder] {
+                    if (folder) {
+                        enterUrl(QUrl::fromLocalFile(path));
+                    } else {
+                        q->setSelectedUrl(QUrl::fromLocalFile(path)); // its folder, with it selected
+                    }
+                });
+                layout->addWidget(row);
+            }
+        }
+    }
+
+    // the filters: the kinds in the folder, with how many
+    layout->addSpacing(4);
+    layout->addWidget(new NgPill(ngLabel(nullptr, nullptr, "Filters", "Filtri"), m_ngCard));
+    m_ngSideFilters = new QWidget(m_ngCard);
+    auto *filters = new QVBoxLayout(m_ngSideFilters);
+    filters->setContentsMargins(0, 0, 0, 0);
+    filters->setSpacing(1);
+    layout->addWidget(m_ngSideFilters);
+
+    // the disk
+    layout->addSpacing(8);
+    auto *disk = new NgDiskBox(m_ngCard);
+    disk->opened = [this](const QString &root) {
+        enterUrl(QUrl::fromLocalFile(root));
+    };
+    layout->addWidget(disk);
+
+    ngFillSide();
+    return m_ngCard;
+}
+
+void KFileWidgetPrivate::ngFillSide()
+{
+    if (!m_ngSideFilters) {
+        return;
+    }
+    QLayout *layout = m_ngSideFilters->layout();
+    while (QLayoutItem *item = layout->takeAt(0)) {
+        delete item->widget();
+        delete item;
+    }
+    for (int kind = 0; kind < ngFilterCount; ++kind) {
+        const int count = m_ngKindCounts.value(kind);
+        if (kind != 0 && count == 0 && kind != m_ngFilter) {
+            continue;
+        }
+        const QString label = kind == 0 ? ngLabel(nullptr, nullptr, "All", "Tutti")
+                                        : ngLabel(ngFilterKinds[kind].domain, ngFilterKinds[kind].context, ngFilterKinds[kind].label, ngFilterKinds[kind].labelIt);
+        auto *row = new NgSideRow(QIcon::fromTheme(QString::fromLatin1(ngFilterKinds[kind].icon)), label, QString::number(count), m_ngSideFilters);
+        row->setCheckable(true);
+        row->setChecked(kind == m_ngFilter);
+        QObject::connect(row, &QAbstractButton::clicked, q, [this, kind] {
+            ngSetFilter(kind);
+        });
+        layout->addWidget(row);
+    }
+}
+
+void KFileWidgetPrivate::ngUpdateBlur()
+{
+    if (!m_ngGlassWindow || !m_ngCard || !m_ngGlassWindow->windowHandle()) {
+        return;
+    }
+    QRegion region;
+    if (m_ngCard->isVisible()) {
+        const QRectF card = m_ngCard->cardRect();
+        region = QRegion(QRect(m_ngCard->mapTo(m_ngGlassWindow, card.topLeft().toPoint()), card.size().toSize()));
+    }
+    KWindowEffects::enableBlurBehind(m_ngGlassWindow->windowHandle(), !region.isEmpty(), region);
+}
