+bool ngDark(const QWidget *widget)
+{
+    return widget->palette().color(QPalette::Window).lightnessF() < 0.5;
+}
+
+// the card the sidebar sits on: glass over the compositor's blur (the window is see-through there), or, without a
+// compositor that blurs, a tinted panel
+class NgSideCard : public QWidget
+{
+public:
+    using QWidget::QWidget;
+    bool glass = false;
+    std::function<void()> geometryChanged;
+
+    QRectF cardRect() const
+    {
+        return QRectF(rect()).adjusted(6, 4, -4, -6);
+    }
+
+protected:
+    void paintEvent(QPaintEvent *) override
+    {
+        QPainter painter(this);
+        painter.setRenderHint(QPainter::Antialiasing);
+        const QRectF card = cardRect();
+        const bool dark = ngDark(this);
+        QPainterPath path;
+        path.addRoundedRect(card, 14, 14);
+        QColor window = palette().color(QPalette::Window);
+        if (glass) {
+            // replaces the window colour painted under it: what shows is the blurred desktop, tinted
+            window.setAlphaF(dark ? 0.40 : 0.48);
+            painter.setCompositionMode(QPainter::CompositionMode_Source);
+            painter.fillPath(path, window);
+            painter.setCompositionMode(QPainter::CompositionMode_SourceOver);
+        } else {
+            const QColor accent = palette().color(QPalette::Highlight);
+            QLinearGradient gradient(card.topLeft(), card.bottomRight());
+            gradient.setColorAt(0, QColor::fromRgbF(window.redF() * 0.8 + accent.redF() * 0.2, window.greenF() * 0.8 + accent.greenF() * 0.2,
+                                                    window.blueF() * 0.8 + accent.blueF() * 0.2));
+            gradient.setColorAt(1, dark ? window.darker(115) : window.darker(104));
+            painter.fillPath(path, gradient);
+        }
+        painter.setPen(QPen(dark ? QColor(255, 255, 255, 40) : QColor(0, 0, 0, 30), 1));
+        painter.drawRoundedRect(card.adjusted(0.5, 0.5, -0.5, -0.5), 13.5, 13.5);
+    }
+    void resizeEvent(QResizeEvent *event) override
+    {
+        QWidget::resizeEvent(event);
+        if (geometryChanged) {
+            geometryChanged();
+        }
+    }
+    void moveEvent(QMoveEvent *event) override
+    {
+        QWidget::moveEvent(event);
+        if (geometryChanged) {
+            geometryChanged();
+        }
+    }
+};
