+    {nullptr, nullptr, "Code and data", "Codice e dati", "application-json", "*.json *.xml *.yaml *.yml *.toml *.ini *.conf *.sh *.py *.js *.ts *.c *.cpp *.h *.hpp *.rs *.go *.java *.html *.css *.sql *.qml *.cmake"},
+};
+const int ngFilterCount = sizeof(ngFilterKinds) / sizeof(ngFilterKinds[0]);
+}
+
+QWidget *KFileWidgetPrivate::ngFilterButtons(QWidget *parent, bool vertical)
+{
+    auto *box = new QWidget(parent);
+    QBoxLayout *layout = vertical ? static_cast<QBoxLayout *>(new QVBoxLayout(box)) : static_cast<QBoxLayout *>(new QHBoxLayout(box));
+    layout->setContentsMargins(vertical ? 8 : 6, vertical ? 10 : 6, 8, vertical ? 10 : 6);
+    layout->setSpacing(4);
+    auto *title = new QLabel(ngLabel(nullptr, nullptr, "Filters", "Filtri"), box);
+    title->setEnabled(false);
+    QFont titleFont = title->font();
+    titleFont.setBold(vertical);
+    title->setFont(titleFont);
+    title->setContentsMargins(vertical ? 6 : 2, 0, 6, vertical ? 2 : 0);
+    layout->addWidget(title);
+    for (int kind = 0; kind < ngFilterCount; ++kind) {
+        auto *button = new QToolButton(box);
+        button->setAutoRaise(true);
+        button->setCheckable(true);
+        button->setChecked(kind == m_ngFilter);
+        button->setText(ngLabel(ngFilterKinds[kind].domain, ngFilterKinds[kind].context, ngFilterKinds[kind].label, ngFilterKinds[kind].labelIt));
+        button->setIcon(QIcon::fromTheme(QString::fromLatin1(ngFilterKinds[kind].icon)));
+        button->setToolButtonStyle(Qt::ToolButtonTextBesideIcon);
+        if (vertical) {   // as tall as the places above, not a cramped list
+            button->setIconSize(QSize(20, 20));
+            button->setMinimumHeight(32);
+        }
+        button->setProperty("_kio_ng_filter", kind);
+
+        QObject::connect(button, &QToolButton::clicked, q, [this, kind] {
+            ngSetFilter(kind);
+        });
+        m_ngFilterButtons.append(button);
+        layout->addWidget(button, 0, vertical ? Qt::AlignLeft : Qt::Alignment());
+    }
+    if (!vertical) {
+        layout->addStretch(1);
+    }
+    return box;
+}
+
+void KFileWidgetPrivate::ngSetFilter(int kind)
+{
+    m_ngFilter = qBound(0, kind, ngFilterCount - 1);
+    for (QToolButton *button : std::as_const(m_ngFilterButtons)) {
+        button->setChecked(button->property("_kio_ng_filter").toInt() == m_ngFilter);
+    }
+    if (m_ngFilter == 0) {
+        slotFileFilterChanged(); // back to what the dialog's own filter says
+        ngUpdateBar();
+        ngFillChips();
+        return;
+    }
+    // only this kind, and no folders: the lister keeps folders for a name filter, but not for a type
+    // filter without inode/directory, so the patterns are turned into the file types they stand for
+    const QString patterns = QString::fromLatin1(ngFilterKinds[m_ngFilter].patterns);
+    QStringList types;
+    QMimeDatabase db;
+    for (const QString &pattern : patterns.split(QLatin1Char(' '), Qt::SkipEmptyParts)) {
+        const QMimeType type = db.mimeTypeForFile(QLatin1String("x") + pattern.mid(1), QMimeDatabase::MatchExtension);
+        if (type.isValid() && !type.isDefault() && !types.contains(type.name())) {
+            types.append(type.name());
+        }
+    }
+    m_ops->clearFilter();
+    m_ops->setMimeFilter(types);
+    m_ops->setNameFilter(patterns);
+    m_ops->updateDir();
+    ngUpdateBar();
+    ngFillChips();
+}
