+// kio-ng: the quick preview --------------------------------------------------------------------------------------------
+namespace
+{
+// a large picture of a file, beside the pointer; not a window one can click or focus
+class NgQuickView : public QWidget
+{
+public:
+    NgQuickView(const QPixmap &pixmap, const QString &caption, QWidget *parent)
+        : QWidget(parent)
+        , m_pixmap(pixmap)
+        , m_caption(caption)
+    {
+        setAttribute(Qt::WA_TransparentForMouseEvents);
+        const QSizeF image = QSizeF(pixmap.size()) / pixmap.devicePixelRatio();
+        resize(int(image.width()) + 20, int(image.height()) + 20 + fontMetrics().height() + 6);
+    }
+
+protected:
+    void paintEvent(QPaintEvent *) override
+    {
+        QPainter painter(this);
+        painter.setRenderHint(QPainter::Antialiasing);
+        const QRectF frame = QRectF(rect()).adjusted(0.5, 0.5, -0.5, -0.5);
+        const bool dark = palette().color(QPalette::Window).lightnessF() < 0.5;
+        painter.setPen(QPen(dark ? QColor(255, 255, 255, 40) : QColor(0, 0, 0, 40), 1));
+        painter.setBrush(palette().color(QPalette::Window));
+        painter.drawRoundedRect(frame, 12, 12);
+        const QSizeF image = QSizeF(m_pixmap.size()) / m_pixmap.devicePixelRatio();
+        const QRectF target(10, 10, image.width(), image.height());
+        QPainterPath clip;
+        clip.addRoundedRect(target, 7, 7);
+        painter.save();
+        painter.setClipPath(clip);
+        painter.drawPixmap(target.topLeft(), m_pixmap);
+        painter.restore();
+        painter.setPen(palette().color(QPalette::WindowText));
+        painter.drawText(QRectF(12, target.bottom() + 3, width() - 24, fontMetrics().height() + 4), Qt::AlignLeft | Qt::AlignVCenter,
+                         fontMetrics().elidedText(m_caption, Qt::ElideMiddle, width() - 24));
+    }
+
+private:
+    QPixmap m_pixmap;
+    QString m_caption;
+};
+}
+
+void KDirOperatorDetailView::ngHoverAt(const QPoint &pos)
+{
+    const QModelIndex index = indexAt(pos);
+    const QModelIndex row = index.isValid() ? index.sibling(index.row(), 0) : QModelIndex();
+    if (row == m_ngHoverIndex) {
+        m_ngHoverPos = pos;
+        return;
+    }
+    ngHideQuickView();
+    m_ngHoverIndex = row;
+    m_ngHoverPos = pos;
+    const KFileItem item = row.data(KDirModel::FileItemRole).value<KFileItem>();
+    const QVariant quick = m_dirOperator->property("_ng_quick");
+    if (row.isValid() && !item.isNull() && !item.isDir() && (!quick.isValid() || quick.toBool())) {
+        m_ngHoverTimer.setInterval(qBound(0, m_dirOperator->property("_ng_quick_delay").toInt(), 3000)); // 0: at once
+        m_ngHoverTimer.start();
+    }
+}
+
+void KDirOperatorDetailView::ngHideQuickView()
+{
+    m_ngHoverTimer.stop();
+    ++m_ngPreviewSerial; // a preview on its way is not wanted any more
+    if (m_ngQuickView) {
+        m_ngQuickView->deleteLater();
+        m_ngQuickView = nullptr;
+    }
+}
+
+void KDirOperatorDetailView::ngShowQuickView(const QPixmap &pixmap)
+{
+    const KFileItem item = m_ngHoverIndex.data(KDirModel::FileItemRole).value<KFileItem>();
+    // a layer over the dialog (not a window of its own: those are placed unreliably on Wayland), beside the pointer on
+    // the side with room, inside the dialog; the picture is made smaller if the dialog is
+    QWidget *host = window();
+    QPixmap picture = pixmap;
+    const QSize room = host->size() - QSize(60, 80 + fontMetrics().height());
+    const QSizeF logical = QSizeF(picture.size()) / picture.devicePixelRatio();
+    if (logical.width() > room.width() || logical.height() > room.height()) {
+        const qreal dpr = picture.devicePixelRatio();
+        picture = picture.scaled((QSizeF(room) * dpr).toSize(), Qt::KeepAspectRatio, Qt::SmoothTransformation);
+        picture.setDevicePixelRatio(dpr);
+    }
+    auto *view = new NgQuickView(picture, item.text() + QStringLiteral(" · ") + KIO::convertSize(item.size()), host);
+    m_ngQuickView = view;
+    const QPoint pointer = viewport()->mapTo(host, m_ngHoverPos);
+    QPoint at(pointer.x() + 28, pointer.y() - view->height() / 2);
+    if (at.x() + view->width() > host->width() - 8) {
+        at.setX(pointer.x() - 28 - view->width());
+    }
+    at.setX(qBound(8, at.x(), qMax(8, host->width() - view->width() - 8)));
+    at.setY(qBound(8, at.y(), qMax(8, host->height() - view->height() - 8)));
+    view->move(at);
+    view->raise();
+    view->show();
+}
+
+bool KDirOperatorDetailView::viewportEvent(QEvent *event)
+{
+    if (m_ngStyle != 0) {
+        switch (event->type()) {
+        case QEvent::HoverMove:
+        case QEvent::HoverEnter:
+            ngHoverAt(static_cast<QHoverEvent *>(event)->position().toPoint());
+            break;
+        case QEvent::HoverLeave:
+        case QEvent::Leave:
+        case QEvent::MouseButtonPress:
+        case QEvent::Wheel:
+            ngHideQuickView();
+            m_ngHoverIndex = QModelIndex();
+            break;
+        default:
+            break;
+        }
+    }
+    return QTreeView::viewportEvent(event);
+}
+
+void KDirOperatorDetailView::keyPressEvent(QKeyEvent *event)
+{
+    ngHideQuickView();
+    QTreeView::keyPressEvent(event);
+}
+
+void KDirOperatorDetailView::scrollContentsBy(int dx, int dy)
+{
+    if (m_ngStyle != 0) {
+        ngHideQuickView();
+        m_ngHoverIndex = QModelIndex();
+    }
+    QTreeView::scrollContentsBy(dx, dy);
+}
+
+void KDirOperatorDetailView::ngZoomBy(int steps)
+{
+    // the size of the rows: 80 % to 180 %, kept for every dialog
+    const qreal now = m_dirOperator->property("_ng_scale").toReal() > 0 ? m_dirOperator->property("_ng_scale").toReal() : 1.0;
+    const qreal scale = qBound(0.8, now + 0.15 * steps, 1.85);
+    if (qFuzzyCompare(scale, now)) {
+        return;
+    }
+    m_dirOperator->setProperty("_ng_scale", scale);
+    KConfigGroup ng(KSharedConfig::openConfig(QStringLiteral("dialog-ngrc")), QStringLiteral("View"));
+    ng.writeEntry("RowScale", scale);
+    ng.sync();
+    doItemsLayout();
+    viewport()->update();
+}
+
+void KDirOperatorDetailView::setNgStyle(int style)
+{
+    m_ngStyle = style;
+    if (style == 0) {
+        return;
+    }
+    // the quick preview: when the pointer has rested on a file for a moment
+    m_ngHoverTimer.setSingleShot(true);
+    m_ngHoverTimer.setInterval(650);
+    connect(&m_ngHoverTimer, &QTimer::timeout, this, [this] {
+        const KFileItem item = m_ngHoverIndex.data(KDirModel::FileItemRole).value<KFileItem>();
+        if (item.isNull()) {
+            return;
+        }
+        const int serial = ++m_ngPreviewSerial;
+        // the plugins the user enabled (the same as the preview generator), kept alive for the job; one of the sizes
+        // of the thumbnail cache
+        static const QStringList plugins = KConfigGroup(KSharedConfig::openConfig(QStringLiteral("dolphinrc")), QStringLiteral("PreviewSettings"))
+                                               .readEntry("Plugins", KIO::PreviewJob::defaultPlugins());
+        // small, medium or large (the cache keeps up to 1024 pixels, the scale of the screen included)
+        const QString size = m_dirOperator->property("_ng_quick_size").toString();
+        const int side = size == QLatin1String("small") ? 240 : size == QLatin1String("large") ? 640 : 400;
+        auto *job = KIO::filePreview(KFileItemList{item}, QSize(side, side), &plugins);
+        job->setDevicePixelRatio(qApp->devicePixelRatio());
+        job->setScaleType(KIO::PreviewJob::ScaledAndCached);
+        connect(job, &KIO::PreviewJob::gotPreview, this, [this, serial](const KFileItem &, const QPixmap &pixmap) {
+            if (serial == m_ngPreviewSerial && (underMouse() || qEnvironmentVariableIsSet("DIALOG_NG_DEMO_QUICKVIEW")) && !pixmap.isNull()) {
+                ngShowQuickView(pixmap);
+            }
+        });
+    });
+    setMouseTracking(true);
+    viewport()->setAttribute(Qt::WA_Hover);
+    // for screenshots: DIALOG_NG_DEMO_QUICKVIEW names a file whose quick preview opens as if the pointer rested on it
+    if (const QString demo = qEnvironmentVariable("DIALOG_NG_DEMO_QUICKVIEW"); !demo.isEmpty()) {
+        QTimer::singleShot(2500, this, [this, demo] {
+            for (int row = 0; model() && row < model()->rowCount(); ++row) {
+                const QModelIndex index = model()->index(row, 0);
+                if (index.data(KDirModel::FileItemRole).value<KFileItem>().text() == demo) {
+                    m_ngHoverIndex = index;
+                    m_ngHoverPos = visualRect(index).center();
+                    m_ngHoverTimer.start();
+                    break;
+                }
+            }
+        });
+    }
+    setUniformRowHeights(false);
+    setAlternatingRowColors(false);
+    setRootIsDecorated(false);
+    setItemsExpandable(false);
+    setIndentation(0);
+    setFrameShape(QFrame::NoFrame);
+    header()->hide();
+    for (int column = 1; column < header()->count(); ++column) {
+        setColumnHidden(column, true);
+    }
+    setItemDelegate(new NgRowDelegate(m_dirOperator, style, this));
+}
+
+void KDirOperatorDetailView::drawRow(QPainter *painter, const QStyleOptionViewItem &option, const QModelIndex &index) const
+{
+    if (m_ngStyle == 0) {
+        QTreeView::drawRow(painter, option, index);
+        return;
+    }
+    // the whole row is one tile, drawn by the delegate (no row background of the style, no columns)
+    QStyleOptionViewItem opt = option;
+    opt.rect = QRect(0, option.rect.top(), viewport()->width(), option.rect.height());
+    opt.state &= ~(QStyle::State_Selected | QStyle::State_MouseOver | QStyle::State_HasFocus);
+    if (selectionModel() && selectionModel()->isSelected(index.sibling(index.row(), 0))) {
+        opt.state |= QStyle::State_Selected;
+    }
+    const QPoint cursor = viewport()->mapFromGlobal(QCursor::pos());
+    if (viewport()->underMouse() && opt.rect.contains(cursor)) {
+        opt.state |= QStyle::State_MouseOver;
+    }
+    itemDelegate()->paint(painter, opt, index.sibling(index.row(), 0));
+}
