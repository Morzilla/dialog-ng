+class NgRowDelegate : public QStyledItemDelegate
+{
+public:
+    NgRowDelegate(KDirOperator *op, int style, QObject *parent)
+        : QStyledItemDelegate(parent)
+        , m_op(op)
+        , m_style(style)
+    {
+    }
+
+    // the rows grow and shrink with Ctrl + wheel (the "_ng_scale" of the dir operator); the words grow less
+    qreal scale() const
+    {
+        const qreal value = m_op->property("_ng_scale").toReal();
+        return value > 0 ? value : 1.0;
+    }
+    QFont scaledFont(const QFont &font) const
+    {
+        QFont f = font;
+        f.setPointSizeF(f.pointSizeF() * (1.0 + (scale() - 1.0) * 0.5));
+        return f;
+    }
+    int rowHeight(const QStyleOptionViewItem &option) const
+    {
+        const int line = QFontMetrics(scaledFont(option.font)).height();
+        return int((m_style == 2 ? qMax(26, line + 8) : qMax(40, line * 2 + 8)) * (0.6 + 0.4 * scale()));
+    }
+
+    QString groupOf(const QModelIndex &index) const
+    {
+        return ngGroupOf(index.data(KDirModel::FileItemRole).value<KFileItem>(), m_op->sorting(), m_op->property("_ng_created").toBool());
+    }
+
+    int headerHeight(const QModelIndex &index, const QStyleOptionViewItem &option) const
+    {
+        if (!m_op->property("_ng_groups").toBool() || index.parent().isValid()) {
+            return 0;
+        }
+        const bool first = index.row() == 0 || groupOf(index.sibling(index.row() - 1, 0)) != groupOf(index);
+        return first ? option.fontMetrics.height() + (index.row() == 0 ? 10 : 18) : 0;
+    }
+
+    QSize sizeHint(const QStyleOptionViewItem &option, const QModelIndex &index) const override
+    {
+        return QSize(200, rowHeight(option) + headerHeight(index, option));
+    }
+
+    void paint(QPainter *painter, const QStyleOptionViewItem &option, const QModelIndex &index) const override
+    {
+        const KFileItem item = index.data(KDirModel::FileItemRole).value<KFileItem>();
+        if (item.isNull()) {
+            QStyledItemDelegate::paint(painter, option, index);
+            return;
+        }
+        const bool compact = m_style == 2;
+        QStyleOptionViewItem scaledOption = option;
+        scaledOption.font = scaledFont(option.font);
+        scaledOption.fontMetrics = QFontMetrics(scaledOption.font);
+        const QStyleOptionViewItem &opt = scaledOption;
+        const QPalette &pal = option.palette;
+        const QColor fg = pal.color(QPalette::Text);
+        const bool dark = pal.color(QPalette::Base).lightnessF() < 0.5;
+        QColor dim = fg;
+        dim.setAlphaF(0.62);
+
+        painter->save();
+        painter->setRenderHint(QPainter::Antialiasing);
+        QRectF row = option.rect;
+
+        // the group title, above the first row of a group
+        const int header = headerHeight(index, option);
+        if (header > 0) {
+            QFont titleFont = option.font;
+            titleFont.setPointSizeF(titleFont.pointSizeF() * 0.86);
+            titleFont.setWeight(QFont::DemiBold);
+            titleFont.setCapitalization(QFont::AllUppercase);
+            titleFont.setLetterSpacing(QFont::PercentageSpacing, 104);
+            painter->setFont(titleFont);
+            painter->setPen(dim);
+            painter->drawText(QRectF(row.left() + 12, row.top(), row.width() - 24, header - 3), Qt::AlignLeft | Qt::AlignBottom, groupOf(index));
+            row.setTop(row.top() + header);
+        }
+
+        // the row: a soft tile; the selection and the pointer tint it
+        const QRectF cell = compact ? row.adjusted(4, 1, -6, -1) : row.adjusted(4, 1.5, -6, -1.5);
+        const qreal radius = compact ? 6 : 9;
+        QColor ground;
+        if (option.state & QStyle::State_Selected) {
+            ground = pal.color(QPalette::Highlight);
+            ground.setAlphaF(dark ? 0.38 : 0.28);
+        } else if (option.state & QStyle::State_MouseOver) {
+            ground = fg;
+            ground.setAlphaF(0.07);
+        } else if (!compact) {
+            ground = fg;
+            ground.setAlphaF(dark ? 0.035 : 0.03);
+        }
+        if (ground.isValid()) {
+            painter->setPen(Qt::NoPen);
+            painter->setBrush(ground);
+            painter->drawRoundedRect(cell, radius, radius);
+        }
+
+        // the tile of the kind: Dolphin NG's drawing of it (a folder with how many items it holds, a page, a table, a
+        // waveform...), or the file's own preview
+        const qreal tileHeight = compact ? qMax(18.0, cell.height() - 6) : qMax(28.0, cell.height() - 8);
+        const QSizeF tileSize(qRound(tileHeight * (compact ? 1.6 : 1.5)), tileHeight);
+        const QRectF tile(cell.left() + (compact ? 6 : 8), cell.center().y() - tileSize.height() / 2, tileSize.width(), tileSize.height());
+        const NgKindInfo kind = ngKindFor(item.name(), item.isDir());
+        int childCount = -1;
+        if (item.isDir()) {
+            const QVariant count = index.sibling(index.row(), KDirModel::Size).data(KDirModel::ChildCountRole);
+            childCount = count.typeId() == QMetaType::Int ? count.toInt() : -1;
+        }
+        const QIcon preview = item.isDir() ? QIcon() : index.data(Qt::DecorationRole).value<QIcon>();
+        if (!preview.isNull() && preview.name().isEmpty()) {
+            // a real preview (the preview generator's pictures have no theme name): the picture itself, cropped to
+            // the tile, with the kind's letters in a corner
+            const qreal dpr = painter->device() ? painter->device()->devicePixelRatioF() : 1.0;
+            const QPixmap pixmap = preview.pixmap(QSize(80, 80), dpr);
+            const QSizeF source = QSizeF(pixmap.size()) / pixmap.devicePixelRatio();
+            const qreal fit = qMax(tile.width() / source.width(), tile.height() / source.height());
+            const QSizeF drawn = source * fit;
+            const QRectF target(tile.center().x() - drawn.width() / 2, tile.center().y() - drawn.height() / 2, drawn.width(), drawn.height());
+            QPainterPath clip;
+            clip.addRoundedRect(tile, compact ? 4 : 5, compact ? 4 : 5);
+            painter->save();
+            painter->setClipPath(clip, Qt::IntersectClip);
+            painter->drawPixmap(target, pixmap, QRectF(QPointF(0, 0), QSizeF(pixmap.size())));
+            painter->restore();
+            if (!compact) {
+                QFont badgeFont = opt.font;
+                badgeFont.setPixelSize(8);
+                badgeFont.setWeight(QFont::Black);
+                const QFontMetricsF badgeFm(badgeFont);
+                const QRectF badge(tile.left(), tile.bottom() - badgeFm.height() - 1, badgeFm.horizontalAdvance(kind.sigla) + 6, badgeFm.height() + 1);
+                painter->setPen(Qt::NoPen);
+                painter->setBrush(kind.tint.darker(dark ? 100 : 120));
+                painter->drawRoundedRect(badge, 2.5, 2.5);
+                painter->setFont(badgeFont);
+                painter->setPen(QColor(30, 33, 38));
+                painter->drawText(badge, Qt::AlignCenter, kind.sigla);
+            }
+        } else {
+            painter->save();
+            painter->setClipRect(tile.adjusted(-3, -3, 3, 3), Qt::IntersectClip); // some drawings reach past their band
+            const QString size = item.isDir() ? QString() : KIO::convertSize(item.size());
+            ngPaintContentSketch(painter, tile, kind.category, kind.sigla, kind.tint, dark, childCount, size, (compact || tileHeight < 30) ? nullptr : &opt.font);
+            painter->restore();
+        }
+
+        // the words: name (with the pushpin of a pinned item), type and size, how long ago it changed
+        const qreal left = tile.right() + (compact ? 10 : 12);
+        const qreal right = cell.right() - 12;
+        QFont nameFont = opt.font;
+        nameFont.setWeight(compact ? QFont::Medium : QFont::DemiBold);
+        QFont smallFont = opt.font;
+        smallFont.setPointSizeF(smallFont.pointSizeF() * (compact ? 0.9 : 0.88));
+        const QFontMetricsF nameFm(nameFont), smallFm(smallFont);
+
+        QString meta;
+        if (item.isDir()) {
+            meta = childCount >= 0 ? ngPlural(childCount, "%1 item", "%1 items", "%1 elemento", "%1 elementi") : ngTr("Folder", "Cartella");
+            if (!compact) {
+                meta = ngTr("Folder", "Cartella") + (childCount >= 0 ? QStringLiteral(" · ") + meta : QString());
+            }
+        } else {
+            meta = item.mimeComment() + QStringLiteral(" · ") + KIO::convertSize(item.size());
+        }
+        // the date the folder is sorted by: of creation when chosen so
+        const bool created = m_op->property("_ng_created").toBool() && (m_op->sorting() & QDir::SortByMask) == QDir::Time;
+        const QString ago = ngAgo(item.time(created ? KFileItem::CreationTime : KFileItem::ModificationTime), compact);
+        const QString changed = created ? ngTr("Created ", "Creato ") : ngTr("Modified ", "Modificato ");
+        QFont agoBold = smallFont;
+        agoBold.setWeight(QFont::DemiBold);
+        const QFontMetricsF agoBoldFm(agoBold);
+        const qreal agoWidth = compact ? smallFm.horizontalAdvance(ago) : smallFm.horizontalAdvance(changed) + agoBoldFm.horizontalAdvance(ago);
+        const bool showAgo = right - left > agoWidth + 120;
+        const qreal textRight = showAgo ? right - agoWidth - 16 : right;
+        const bool pinned = ngPinned(item);
+        const qreal pinRoom = pinned ? 20 : 0;
+
+        // as in Dolphin NG: a small see-through disc with a hairline, the pushpin filled in a light shade of the
+        // kind's colour
+        auto drawPin = [&](qreal x, qreal centreY) {
+            const qreal r = compact ? 7.5 : 8.5;
+            const QPointF c(x + r, centreY);
+            QColor hairline = fg;
+            hairline.setAlphaF(dark ? 0.16 : 0.14);
+            painter->setPen(QPen(hairline, 1));
+            painter->setBrush(dark ? QColor(14, 15, 18, 150) : QColor(255, 255, 255, 190));
+            painter->drawEllipse(c, r, r);
+            const QColor t = kind.tint;
+            const qreal hue = t.hslHueF() < 0 ? 0 : t.hslHueF();
+            const QColor tint = dark ? QColor::fromHslF(hue, qMin(t.hslSaturationF(), 0.55), 0.78) : QColor::fromHslF(hue, qMin(t.hslSaturationF(), 0.65), 0.38);
+            const qreal glyph = r * 1.35;
+            ngDrawPin(painter, QRectF(c.x() - glyph / 2, c.y() - glyph / 2, glyph, glyph), tint, true, 1.6);
+        };
+
+        if (compact) {
+            const qreal mid = cell.center().y();
+            const QString name = nameFm.elidedText(item.text(), Qt::ElideMiddle, qMax(40.0, (textRight - left) * 0.62 - pinRoom));
+            const qreal nameWidth = nameFm.horizontalAdvance(name);
+            painter->setFont(nameFont);
+            painter->setPen(fg);
+            painter->drawText(QRectF(left, cell.top(), nameWidth + 2, cell.height()), Qt::AlignLeft | Qt::AlignVCenter, name);
+            qreal x = left + nameWidth + 8;
+            if (pinned) {
+                drawPin(x - 3, mid);
+                x += pinRoom;
+            }
+            painter->setFont(smallFont);
+            painter->setPen(dim);
+            painter->drawText(QRectF(x + 4, cell.top(), qMax(0.0, textRight - x - 4), cell.height()),
+                              Qt::AlignLeft | Qt::AlignVCenter,
+                              smallFm.elidedText(meta, Qt::ElideRight, qMax(0.0, textRight - x - 4)));
+            if (showAgo) {
+                painter->drawText(QRectF(right - agoWidth, cell.top(), agoWidth, cell.height()), Qt::AlignRight | Qt::AlignVCenter, ago);
+            }
+        } else {
+            const qreal block = nameFm.height() + smallFm.height() + 2;
+            const qreal top = cell.center().y() - block / 2;
+            const QString name = nameFm.elidedText(item.text(), Qt::ElideMiddle, qMax(40.0, textRight - left - pinRoom));
+            painter->setFont(nameFont);
+            painter->setPen(fg);
+            painter->drawText(QRectF(left, top, textRight - left, nameFm.height()), Qt::AlignLeft | Qt::AlignVCenter, name);
+            if (pinned) {
+                drawPin(left + nameFm.horizontalAdvance(name) + 6, top + nameFm.height() / 2);
+            }
+            painter->setFont(smallFont);
+            painter->setPen(dim);
+            painter->drawText(QRectF(left, top + nameFm.height() + 2, textRight - left, smallFm.height()),
+                              Qt::AlignLeft | Qt::AlignVCenter,
+                              smallFm.elidedText(meta, Qt::ElideRight, textRight - left));
+            if (showAgo) {
+                const qreal x = right - agoWidth;
+                const QRectF line(x, cell.top(), agoWidth, cell.height());
+                painter->drawText(line, Qt::AlignLeft | Qt::AlignVCenter, changed);
+                painter->setFont(agoBold);
+                painter->setPen(fg);
+                painter->drawText(line, Qt::AlignRight | Qt::AlignVCenter, ago);
+            }
+        }
+        painter->restore();
+    }
+
+private:
+    KDirOperator *m_op;
+    int m_style;
+};
+}
