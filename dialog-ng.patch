+// how full the disk of the home folder is; a click opens its root
+class NgDiskBox : public QWidget
+{
+public:
+    explicit NgDiskBox(QWidget *parent)
+        : QWidget(parent)
+    {
+        setCursor(Qt::PointingHandCursor);
+        setSizePolicy(QSizePolicy::Expanding, QSizePolicy::Fixed);
+    }
+    std::function<void(const QString &)> opened;
+    QSize sizeHint() const override
+    {
+        return QSize(120, fontMetrics().height() + 30);
+    }
+
+protected:
+    void paintEvent(QPaintEvent *) override
+    {
+        const QStorageInfo storage(QDir::homePath());
+        if (!storage.isValid() || storage.bytesTotal() <= 0) {
+            return;
+        }
+        QPainter painter(this);
+        painter.setRenderHint(QPainter::Antialiasing);
+        const bool dark = ngDark(this);
+        const QRectF box = QRectF(rect()).adjusted(2, 2, -2, -2);
+        painter.setPen(Qt::NoPen);
+        painter.setBrush(dark ? QColor(0, 0, 0, 62) : QColor(255, 255, 255, 130));
+        painter.drawRoundedRect(box, 10, 10);
+        QFont small = font();
+        small.setPointSizeF(small.pointSizeF() * 0.86);
+        painter.setFont(small);
+        painter.setPen(palette().color(QPalette::WindowText));
+        const QRectF text = box.adjusted(10, 6, -10, -18);
+        const QString total = KIO::convertSize(storage.bytesTotal());
+        const QString free = i18nc("@info:status Free disk space", "%1 free", KIO::convertSize(storage.bytesAvailable()));
+        const QFontMetrics fm(small);
+        const bool both = fm.horizontalAdvance(total) + fm.horizontalAdvance(free) + 12 <= text.width();
+        if (both) {
+            painter.drawText(text, Qt::AlignLeft | Qt::AlignVCenter, total);
+        }
+        painter.drawText(text, (both ? Qt::AlignRight : Qt::AlignLeft) | Qt::AlignVCenter, fm.elidedText(free, Qt::ElideRight, int(text.width())));
+        const qreal used = 1.0 - qreal(storage.bytesAvailable()) / qreal(storage.bytesTotal());
+        const QRectF groove(box.left() + 10, box.bottom() - 14, box.width() - 20, 6);
+        painter.setPen(Qt::NoPen);
+        painter.setBrush(dark ? QColor(255, 255, 255, 44) : QColor(0, 0, 0, 36));
+        painter.drawRoundedRect(groove, 3, 3);
+        painter.setBrush(used > 0.9 ? QColor(224, 145, 79) : palette().color(QPalette::Highlight));
+        painter.drawRoundedRect(QRectF(groove.topLeft(), QSizeF(qMax(6.0, groove.width() * used), groove.height())), 3, 3);
+    }
+    void mouseReleaseEvent(QMouseEvent *event) override
+    {
+        if (event->button() == Qt::LeftButton && rect().contains(event->position().toPoint()) && opened) {
+            opened(QStorageInfo(QDir::homePath()).rootPath());
+        }
+    }
+};
+
+// paints the window colour on a see-through window (all of it but the glass, which the card paints itself)
+class NgWindowGround : public QObject
+{
+public:
+    using QObject::QObject;
+    bool eventFilter(QObject *watched, QEvent *event) override
+    {
+        if (event->type() == QEvent::Paint) {
+            auto *window = static_cast<QWidget *>(watched);
+            QPainter painter(window);
+            painter.setCompositionMode(QPainter::CompositionMode_Source);
+            painter.fillRect(static_cast<QPaintEvent *>(event)->rect(), window->palette().color(QPalette::Window));
+        }
+        return false;
+    }
+};
+}
